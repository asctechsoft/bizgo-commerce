{
  "name": "bizgo",
  "private": true,
  "version": "0.1.0",
  "description": "BizGo single-seller commerce platform (modular monolith monorepo)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @bizgo/api test:integration",
    "db:generate": "pnpm --filter @bizgo/db generate",
    "db:migrate:deploy": "pnpm --filter @bizgo/db migrate:deploy",
    "db:seed": "pnpm --filter @bizgo/db seed",
    "owner:bootstrap": "pnpm --filter @bizgo/api owner:bootstrap",
    "stack:build": "node scripts/dev-stack.mjs build",
    "stack:start": "node scripts/dev-stack.mjs start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
