{
  "name": "@bizgo/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "openapi:export": "tsc -p tsconfig.build.json && node dist/cli/export-openapi.js",
    "openapi:check": "tsc -p tsconfig.build.json && node dist/cli/export-openapi.js --check",
    "owner:bootstrap": "tsc -p tsconfig.build.json && node dist/cli/owner-bootstrap.js"
  },
  "dependencies": {
    "@bizgo/db": "workspace:*",
    "@bizgo/shared": "workspace:*",
    "@nestjs/common": "11.1.8",
    "@nestjs/core": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "@nestjs/swagger": "11.2.1",
    "@node-rs/argon2": "2.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.8",
    "@swc/core": "1.13.20",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "unplugin-swc": "1.5.8",
    "vitest": "3.2.7"
  }
}
