  "info": {
    "title": "BizGo API",
    "description": "Single-seller commerce API (Phase 1: auth, catalog read, RBAC). Generated from code; see docs/api.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "customerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bg_sid"
      },
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bg_admin_sid"
      },
      "factorySession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bg_factory_sid"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      },
      "AddressBodyDto": {
        "type": "object",
        "properties": {
          "receiverName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "ward": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "receiverName",
          "phone",
          "province",
          "district",
          "ward",
          "detail"
        ]
      },
      "AddressPatchDto": {
        "type": "object",
        "properties": {
          "receiverName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "ward": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "string",
            "description": "Email or Vietnamese mobile number"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "displayName": {
            "type": "string"
          },
          "acceptTerms": {
            "type": "boolean"
          }
        },
        "required": [
          "identity",
          "password",
          "displayName",
          "acceptTerms"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "realm": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "ADMIN",
              "FACTORY"
            ],
            "default": "CUSTOMER"
          }
        },
        "required": [
          "identity",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Required for bearer (mobile) clients; web uses the refresh cookie"
          },
          "realm": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "ADMIN",
              "FACTORY"
            ],
            "default": "CUSTOMER"
          }
        }
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "REGISTER_VERIFY"
            ]
          }
        },
        "required": [
          "identity",
          "purpose"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "REGISTER_VERIFY"
            ]
          },
          "code": {
            "type": "string",
            "example": "000000",
            "description": "6 digits"
          }
        },
        "required": [
          "identity",
          "purpose",
          "code"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "string"
          }
        },
        "required": [
          "identity"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "MfaVerifyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "6-digit TOTP or XXXXX-XXXXX recovery code"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
