# BizGo environment template. ALL VALUES ARE DUMMY. Copy to .env and replace; never commit real secrets.
# Production values come from the secret store (D10), not from a file in the repo.

APP_ENV=local                       # local | test | staging | production
PORT=4000

# --- PostgreSQL / Redis -----------------------------------------------------------------------------
DATABASE_URL=postgresql://bizgo:change-me@localhost:5432/bizgo?schema=public
REDIS_URL=                          # required when APP_ENV=production (shared rate limiting)

# --- Security (generate: openssl rand -hex 32) -------------------------------------------------------
APP_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32................
COOKIE_DOMAIN=                      # e.g. .bizgo.example in staging/production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false                   # true behind a reverse proxy

# --- Fail-closed switches (see docs/phase0/02_BLOCKED_DECISIONS.md) -------------------------------------
DEV_OTP_CONSOLE=false               # true ONLY on a developer machine: prints OTP codes to the API log
SEED_TEST_FIXTURES=false            # never true in production
SWAGGER_ENABLED=false
RATE_LIMIT_IP_MULTIPLIER=1          # keep 1 outside automated tests

# --- Web apps ---------------------------------------------------------------------------------------
API_BASE_URL=http://localhost:4000              # server-side (Next.js server components)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000  # browser; always a domain, never a VPS IP
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_FIXTURES=false     # build fails in production if true

# --- Dev database without Docker (pnpm --filter @bizgo/db dev:db) ----------------------------------
DEV_DB_PORT=54329
