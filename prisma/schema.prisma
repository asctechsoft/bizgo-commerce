// BizGo Prisma schema — migration batch M001 (Phase 1).
// Source of truth for the plan: docs/architecture/ERD_AND_SCHEMA_PLAN.md
// Rules: BIGINT VND, grams for weight, timestamptz UTC, no cascading deletes on financial data.
// Raw SQL constraints/triggers/indexes live next to the generated SQL in prisma/migrations/*/migration.sql.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum IdentityType {
  EMAIL
  PHONE
}

enum SessionRealm {
  CUSTOMER
  ADMIN
  FACTORY
}

enum OtpPurpose {
  REGISTER_VERIFY
  GUEST_TRACK
  IDENTITY_CHANGE
}

enum ProductStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OriginType {
  UNVERIFIED
  FACTORY_MADE
  FACTORY_PACKED
  FACTORY_DISTRIBUTED
  INTERNAL_SUPPLY
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  DEAD
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      UserStatus @default(PENDING_VERIFICATION)
  displayName String     @map("display_name")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  identities         Identity[]
  passwordCredential PasswordCredential?
  passwordResets     PasswordResetToken[]
  sessions           Session[]
  mfaCredential      MfaCredential?
  roles              UserRole[]
  consents           UserConsent[]
  addresses          Address[]
  otpChallenges      OtpChallenge[]
  cart               Cart?
  orders             Order[]

  @@map("users")
}

model Identity {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       IdentityType
  valueNorm  String       @map("value_norm")
  verifiedAt DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([type, valueNorm])
  @@index([userId])
  @@map("identities")
}

model PasswordCredential {
  userId    String   @id @map("user_id") @db.Uuid
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_credentials")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

model OtpChallenge {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  targetType  IdentityType @map("target_type")
  targetNorm  String       @map("target_norm")
  purpose     OtpPurpose
  codeHmac    Bytes        @map("code_hmac")
  attempts    Int          @default(0)
  maxAttempts Int          @default(5) @map("max_attempts")
  sendCount   Int          @default(1) @map("send_count")
  lastSentAt  DateTime     @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?    @map("consumed_at") @db.Timestamptz(6)
  lockedAt    DateTime?    @map("locked_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([targetType, targetNorm, purpose, createdAt])
  @@map("otp_challenges")
}

/// One row = one access/refresh token pair. Refresh rotates by inserting a new row (same familyId)
/// and stamping usedAt on the old one; presenting a used refresh token revokes the whole family.
model Session {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  realm             SessionRealm
  familyId          String       @map("family_id") @db.Uuid
  accessHash        Bytes        @unique @map("access_hash")
  refreshHash       Bytes        @unique @map("refresh_hash")
  csrfSecret        Bytes        @map("csrf_secret")
  accessExpiresAt   DateTime     @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt  DateTime     @map("refresh_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(6)
  usedAt            DateTime?    @map("used_at") @db.Timestamptz(6)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?      @map("revoked_reason")
  mfaVerifiedAt     DateTime?    @map("mfa_verified_at") @db.Timestamptz(6)
  ipHash            String?      @map("ip_hash")
  uaHash            String?      @map("ua_hash")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, realm])
  @@index([familyId])
  @@map("sessions")
}

model MfaCredential {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  secretEnc      Bytes     @map("secret_enc")
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastUsedStep   BigInt?   @map("last_used_step")
  recoveryHashes String[]  @map("recovery_hashes")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("mfa_credentials")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  name        String
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy String?  @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserConsent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  purpose    String
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipHash     String?  @map("ip_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_consents")
}

model Address {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  receiverName String    @map("receiver_name")
  phone        String
  province     String
  district     String
  ward         String
  detail       String
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("addresses")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceName  String        @unique @map("source_name")
  displayName String        @map("display_name")
  slug        String        @unique
  sortOrder   Int           @map("sort_order")
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

/// source_* columns are immutable (DB trigger) so provenance of the BRD list is never lost.
model Product {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  sourceIndex    Int           @map("source_index")
  sourceName     String        @map("source_name")
  sourceUnitText String        @map("source_unit_text")
  sourceNoteRaw  String        @map("source_note_raw")
  displayNote    String        @map("display_note")
  displayName    String        @map("display_name")
  slug           String        @unique
  originType     OriginType    @default(UNVERIFIED) @map("origin_type")
  status         ProductStatus @default(DRAFT)
  /// normalised (no diacritics, lowercase) text used by search: display name + source name + aliases
  searchText     String        @map("search_text")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media    ProductMedia[]
  aliases  SearchAlias[]
  variants ProductVariant[]

  @@unique([categoryId, sourceIndex])
  @@index([categoryId, status])
  @@index([status])
  @@map("products")
}

model ProductMedia {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  storageKey     String    @map("storage_key")
  isIllustrative Boolean   @default(true) @map("is_illustrative")
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, storageKey])
  @@index([productId])
  @@map("product_media")
}

model SearchAlias {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  alias     String
  aliasNorm String @map("alias_norm")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, aliasNorm])
  @@index([aliasNorm])
  @@map("search_aliases")
}

// ───────────────────────────── Cross-cutting infrastructure ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("settings")
}

/// Append-only (DB trigger forbids UPDATE/DELETE).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?  @map("request_id")
  ipHash     String?  @map("ip_hash")
  reason     String?

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  type          String
  payload       Json
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts      Int          @default(0)
  status        OutboxStatus @default(PENDING)
  lockedBy      String?      @map("locked_by")
  lockedUntil   DateTime?    @map("locked_until") @db.Timestamptz(6)
  lastError     String?      @map("last_error")
  dedupeKey     String?      @unique @map("dedupe_key")

  @@index([status, availableAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  handler     String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([handler, eventId])
  @@map("processed_events")
}

model IdempotencyKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorScope     String    @map("actor_scope")
  scope          String
  key            String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([actorScope, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ───────────────────────── M002 (Phase 2): commerce core ─────────────────────────
// Variants (SKU), prices, supplier costs, inventory ledger, cart, quotes, orders, reservations.
// No row is seeded for real products: SKUs, prices, costs and stock require owner decisions (D02/D04).

enum StorageClass {
  DRY
  AMBIENT
  CHILLED
  FROZEN
  FRAGILE
}

enum SalesChannel {
  RETAIL
  WHOLESALE
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  PACKING
  READY_TO_SHIP
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCEL_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  FAILED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  AUTHORIZED
  PAID
  FAILED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ReservationStatus {
  HELD
  CONSUMED
  RELEASED
  EXPIRED
}

enum StockMovementType {
  RECEIPT
  ADJUST_PLUS
  ADJUST_MINUS
  RESERVE
  RELEASE
  DISPATCH
  RETURN_RESTOCK
  QUARANTINE_IN
  QUARANTINE_OUT
  COUNT_CORRECTION
}

model ProductVariant {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String        @map("product_id") @db.Uuid
  sku               String        @unique
  packLabel         String        @map("pack_label")
  sellableUnit      String        @map("sellable_unit")
  netWeightG        Int?          @map("net_weight_g")
  piecesPerPack     Int?          @map("pieces_per_pack")
  storageClass      StorageClass? @map("storage_class")
  minQty            Int           @default(1) @map("min_qty")
  maxQty            Int?          @map("max_qty")
  quantityStep      Int           @default(1) @map("quantity_step")
  manufacturer      String?
  responsibleEntity String?       @map("responsible_entity")
  shelfLifeDays     Int?          @map("shelf_life_days")
  status            ProductStatus @default(DRAFT)
  /// TEST fixtures only; refused in production (app guard).
  isTest            Boolean       @default(false) @map("is_test")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceRules PriceRule[]
  costs      SupplierCost[]
  balances   InventoryBalance[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, status])
  @@map("product_variants")
}

model PriceRule {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId    String       @map("variant_id") @db.Uuid
  channel      SalesChannel @default(RETAIL)
  tierId       String?      @map("tier_id") @db.Uuid
  minQty       Int          @default(1) @map("min_qty")
  unitPriceVnd BigInt       @map("unit_price_vnd")
  validFrom    DateTime     @map("valid_from") @db.Timestamptz(6)
  validTo      DateTime?    @map("valid_to") @db.Timestamptz(6)
  priority     Int          @default(0)
  createdBy    String?      @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, channel, validFrom])
  @@map("price_rules")
}

/// OWNER/ACCOUNTANT only (permission cost:read). Never joined by public or factory code paths.
model SupplierCost {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId String    @map("variant_id") @db.Uuid
  costVnd   BigInt    @map("cost_vnd")
  validFrom DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, validFrom])
  @@map("supplier_costs")
}

model Warehouse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  isTest    Boolean  @default(false) @map("is_test")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  balances     InventoryBalance[]
  movements    StockMovement[]
  reservations InventoryReservation[]

  @@map("warehouses")
}

/// available = on_hand - reserved - quarantined. CHECK constraints live in the migration SQL.
model InventoryBalance {
  warehouseId String   @map("warehouse_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  onHand      BigInt   @default(0) @map("on_hand")
  reserved    BigInt   @default(0)
  quarantined BigInt   @default(0)
  version     BigInt   @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([warehouseId, variantId])
  @@map("inventory_balances")
}

/// Append-only ledger (DB trigger forbids UPDATE/DELETE).
model StockMovement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  variantId      String            @map("variant_id") @db.Uuid
  type           StockMovementType
  qty            BigInt
  reasonCode     String            @map("reason_code")
  actorId        String?           @map("actor_id") @db.Uuid
  refType        String?           @map("ref_type")
  refId          String?           @map("ref_id")
  idempotencyKey String?           @unique @map("idempotency_key")
  occurredAt     DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([warehouseId, variantId, occurredAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model CheckoutQuote {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  version       Int       @default(1)
  addressId     String?   @map("address_id") @db.Uuid
  snapshot      Json
  canPlaceOrder Boolean   @map("can_place_order")
  totalVnd      BigInt?   @map("total_vnd")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("checkout_quotes")
}

model Order {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber         String        @unique @map("order_number")
  userId              String        @map("user_id") @db.Uuid
  channel             SalesChannel  @default(RETAIL)
  status              OrderStatus   @default(PENDING_CONFIRMATION)
  paymentMethod       PaymentMethod @map("payment_method")
  contactSnapshot     Json          @map("contact_snapshot")
  shipAddressSnapshot Json          @map("ship_address_snapshot")
  subtotalVnd         BigInt        @map("subtotal_vnd")
  discountVnd         BigInt        @default(0) @map("discount_vnd")
  /// null = shipping fee not determined (manual-quote policy); never 0 by default.
  shippingFeeVnd      BigInt?       @map("shipping_fee_vnd")
  totalVnd            BigInt        @map("total_vnd")
  isTest              Boolean       @default(false) @map("is_test")
  quoteId             String?       @map("quote_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  events       OrderStatusEvent[]
  payments     Payment[]
  reservations InventoryReservation[]
  financial    OrderFinancial?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  variantId        String        @map("variant_id") @db.Uuid
  skuSnap          String        @map("sku_snap")
  nameSnap         String        @map("name_snap")
  packLabelSnap    String        @map("pack_label_snap")
  netWeightGSnap   Int?          @map("net_weight_g_snap")
  storageClassSnap StorageClass? @map("storage_class_snap")
  qty              Int
  unitPriceVnd     BigInt        @map("unit_price_vnd")
  lineDiscountVnd  BigInt        @default(0) @map("line_discount_vnd")
  lineTotalVnd     BigInt        @map("line_total_vnd")
  /// Permissioned: never serialised to customers or factories.
  supplierCostVnd  BigInt?       @map("supplier_cost_vnd")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations InventoryReservation[]

  @@index([orderId])
  @@map("order_items")
}

/// Append-only (trigger).
model OrderStatusEvent {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  reasonCode String?      @map("reason_code")
  requestId  String?      @map("request_id")
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, occurredAt])
  @@map("order_status_events")
}

/// Expected-margin snapshot at order time. Never exposed to customers or factories (permission margin:read).
model OrderFinancial {
  orderId           String   @id @map("order_id") @db.Uuid
  revenueNetVnd     BigInt   @map("revenue_net_vnd")
  costSnapshotVnd   BigInt?  @map("cost_snapshot_vnd")
  expectedMarginVnd BigInt?  @map("expected_margin_vnd")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("order_financials")
}

model Payment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amountVnd BigInt        @map("amount_vnd")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("payments")
}

model InventoryReservation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  orderItemId String            @map("order_item_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  variantId   String            @map("variant_id") @db.Uuid
  qty         BigInt
  status      ReservationStatus @default(HELD)
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}
