{
  "name": "@bizgo/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "migrate:diff": "prisma migrate diff --from-migrations ../../prisma/migrations --to-schema-datamodel ../../prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seed/run.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@bizgo/shared": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "embedded-postgres": "17.9.0-beta.16",
    "pg": "8.16.3",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "vitest": "3.2.7"
  }
}
